@section Styles {
    <link rel="stylesheet" href="~/css/views/index.css" asp-append-version="true" />
}

@model SchwarzesBrett.ViewModels.IndexViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Übersicht";
    var icons = Model.Lookups.Categories.ToDictionary(c => c.Id, c => c.Icon);
}

<!-- ================= Suche und Sortierung ================= -->
<div class="d-flex gap-3 mb-4">
    <div class="search-box flex-grow-1">
        <i class="bi bi-search"></i>
        <input type="text" id="searchInput" class="form-control"
               placeholder="Wonach suchst du? z. B. Fahrrad, Nachhilfe, Wohnung" />
    </div>

    <select id="sortSelect" class="form-select sort-select">
        <option value="newest">Neueste zuerst</option>
        <option value="oldest">Älteste zuerst</option>
        <option value="price-asc">Preis aufsteigend</option>
        <option value="price-desc">Preis absteigend</option>
    </select>
</div>

<div class="row g-4">

    <!-- ================= Kategorien links ================= -->
    <div class="col-lg-3">
        <small class="cat-heading">Kategorien</small>

        <div class="cat-list">
            <button type="button" class="cat-item active" data-category="all">
                <i class="bi bi-grid-fill"></i>
                <span class="flex-grow-1">Alle Kategorien</span>
                <span class="cat-count">@Model.Tiles.Count()</span>
            </button>

            @foreach (var category in Model.Lookups.Categories)
            {
                <button type="button" class="cat-item" data-category="@category.Id">
                    <i class="bi @category.Icon"></i>
                    <span class="flex-grow-1">@category.Name</span>
                    <span class="cat-count">@Model.Tiles.Count(t => t.CategoryID == category.Id)</span>
                </button>
            }
        </div>
    </div>

    <!-- ================= Inserate rechts ================= -->
    <div class="col-lg-9">
        <div class="listings-box">

            <!-- Umschalter Angebote / Gesuche -->
            <div class="type-switch">
                <button type="button" class="type-btn active" data-type="all">
                    <i class="bi bi-grid-3x3-gap"></i> Alles
                </button>
                <button type="button" class="type-btn" data-type="1">
                    <i class="bi bi-box-seam"></i> Angebote
                </button>
                <button type="button" class="type-btn" data-type="2">
                    <i class="bi bi-search"></i> Gesucht
                </button>
            </div>

            <h4 class="listings-count">
                <span id="resultCount">@Model.Tiles.Count()</span> <span id="resultLabel">Inserate</span>
            </h4>

            <!-- Kacheln -->
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3" id="tileGrid">
                @foreach (var tile in Model.Tiles)
                {
                    string imageUrl = tile.TitleImageId is int imgId
                    ? Url.Action("Attachment", new { id = imgId })!
                    : Url.Content($"~/Images/CategoryPlaceholders/Placeholder_{tile.CategoryID}.svg");

                    <div class="col tile-col"
                         data-category="@tile.CategoryID"
                         data-type="@tile.ListingTypeId"
                         data-search="@((tile.Name + " " + tile.CategoryName).ToLower())"
                         data-price="@(tile.Price?.ToString(CultureInfo.InvariantCulture) ?? "")"
                         data-created="@tile.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")">

                        <a asp-action="Details" asp-route-id="@tile.Id" class="tile">
                            <div class="tile-image">
                                <img src="@imageUrl" alt="@tile.Name" />
                                <span class="tile-icon">
                                    <i class="bi @(icons.GetValueOrDefault(tile.CategoryID, "bi-three-dots"))"></i>
                                </span>
                            </div>

                            <div class="tile-body">
                                <div class="tile-title">@tile.Name</div>

                                <div class="tile-footer">
                                    <div class="tile-price">
                                        @if (tile.Price is decimal price)
                                        {
                                            @price.ToString("#,0.## €")
                                            <small>@tile.PriceCategoryName</small>
                                        }
                                        else
                                        {
                                            @tile.PriceCategoryName
                                        }
                                    </div>
                                    <div class="tile-meta">@tile.AgeText</div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>

            <p id="noResults" class="text-muted text-center py-5 d-none">
                Keine Inserate gefunden.
            </p>

        </div>
    </div>
</div>


@section Scripts {
    <script>
        const grid = document.getElementById('tileGrid');
        const cols = Array.from(grid.querySelectorAll('.tile-col'));
        const searchInput = document.getElementById('searchInput');
        const sortSelect = document.getElementById('sortSelect');
        const noResults = document.getElementById('noResults');
        const resultCount = document.getElementById('resultCount');
        const resultLabel = document.getElementById('resultLabel');

        let currentCategory = 'all';
        let currentType = 'all';
        const labels = { 'all': 'Inserate', '1': 'Angebote', '2': 'Gesuche' };

        // Preis als Zahl; ohne Preis (Verschenken/Tausch) zählt als 0
        function priceOf(col) {
            return col.dataset.price === '' ? 0 : parseFloat(col.dataset.price);
        }

        function apply() {
            const query = searchInput.value.trim().toLowerCase();
            const sort = sortSelect.value;

            // 1. Sortieren
            cols.sort(function (a, b) {
                switch (sort) {
                    case 'oldest':     return a.dataset.created.localeCompare(b.dataset.created);
                    case 'price-asc':  return priceOf(a) - priceOf(b);
                    case 'price-desc': return priceOf(b) - priceOf(a);
                    default:           return b.dataset.created.localeCompare(a.dataset.created);
                }
            });

            // 2. Filtern und Kategorien neu zählen
            let visible = 0;
            const categoryCounts = {};

            cols.forEach(function (col) {
                const matchesType   = currentType === 'all' || col.dataset.type === currentType;
                const matchesSearch = query === '' || col.dataset.search.includes(query);

                // Für die Zahlen links: passt zu Typ und Suche (Kategorie egal)
                if (matchesType && matchesSearch) {
                    const cat = col.dataset.category;
                    categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
                }

                const matchesCategory = currentCategory === 'all' || col.dataset.category === currentCategory;
                const show = matchesType && matchesSearch && matchesCategory;

                col.classList.toggle('d-none', !show);
                if (show) visible++;

                grid.appendChild(col);   // in neuer Reihenfolge einsortieren
            });

            // 3. Anzeigen aktualisieren
            resultCount.textContent = visible;
            resultLabel.textContent = labels[currentType];
            noResults.classList.toggle('d-none', visible > 0);

            document.querySelectorAll('.cat-item').forEach(function (btn) {
                const cat = btn.dataset.category;
                const count = cat === 'all'
                    ? Object.values(categoryCounts).reduce(function (sum, n) { return sum + n; }, 0)
                    : (categoryCounts[cat] || 0);
                btn.querySelector('.cat-count').textContent = count;
            });
        }

        // Kategorien links
        document.querySelectorAll('.cat-item').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.cat-item').forEach(function (b) { b.classList.remove('active'); });
                this.classList.add('active');
                currentCategory = this.dataset.category;
                apply();
            });
        });

        // Umschalter Alles / Angebote / Gesuche
        document.querySelectorAll('.type-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.type-btn').forEach(function (b) { b.classList.remove('active'); });
                this.classList.add('active');
                currentType = this.dataset.type;
                apply();
            });
        });

        // Suche und Sortierung
        searchInput.addEventListener('input', apply);
        sortSelect.addEventListener('change', apply);

        apply();
    </script>
}