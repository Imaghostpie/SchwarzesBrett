@section Styles {
    <link rel="stylesheet" href="~/css/views/my.css" asp-append-version="true" />
}

@model MyViewModel

@{
     ViewData["Title"] = "Meine Inserate";

    int activeCount = Model.Tiles.Count(t => t.StatusId == 1);
    var tabs = Model.Statuses.Where(s => s.Id != 5).ToList();                    // alle außer Gelöscht
    var selectable = Model.Statuses.Where(s => s.Id != 4 && s.Id != 5).ToList(); 
}

<!-- ================= Kopfzeile ================= -->
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="page-title">Meine Inserate</h1>
        <small class="text-muted">@Model.Tiles.Count Inserate, davon @activeCount aktiv</small>
    </div>

    <select id="sortSelect" class="form-select sort-select">
        <option value="newest">Neueste zuerst</option>
        <option value="oldest">Älteste zuerst</option>
        <option value="expiring">Läuft bald ab</option>
    </select>
</div>

<!-- ================= Status- ================= -->
<div class="status-tabs">
    <button type="button" class="status-tab active" data-status="all">
        Alle <span class="tab-count">@Model.Tiles.Count</span>
    </button>

    @foreach (var tab in tabs)
    {
        <button type="button" class="status-tab" data-status="@tab.Id">
            @tab.Name <span class="tab-count">@Model.Tiles.Count(t => t.StatusId == tab.Id)</span>
        </button>
    }
</div>

<!-- ================= Liste ================= -->
<div id="myList">
    @if (Model.Tiles.Count == 0)
    {
        <div class="defaultdiv p-5 text-center text-muted">
            Du hast noch keine Inserate.<br />
            <a asp-action="Create" class="btn btn-primary mt-3">Erstes Inserat erstellen</a>
        </div>
    }

    @foreach (var tile in Model.Tiles)
    {
        string imageUrl = tile.TitleImageId is int imgId
        ? Url.Action("Attachment", new { id = imgId })!
        : Url.Content($"~/Images/CategoryPlaceholders/Placeholder_{tile.CategoryID}.svg");

        bool isExpired = tile.StatusId == 4;
        bool showExtend = !tile.IsPermanent
            && (isExpired || (tile.StatusId is 1 or 2 or 6 && tile.DaysLeft <= 14));

        <div class="my-row @(tile.StatusId == 3 ? "is-done" : "")"
             data-status="@tile.StatusId"
             data-created="@tile.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")"
             data-validuntil="@(tile.ValidUntil?.ToString("yyyy-MM-ddTHH:mm:ss") ?? "9999-12-31")">

            <a asp-action="Details" asp-route-id="@tile.Id" class="my-thumb">
                <img src="@imageUrl" alt="@tile.Name" />
                <span class="my-type my-type-@tile.ListingTypeId">@tile.ListingTypeName</span>
            </a>

            <div class="my-info">
                <small class="my-category">@tile.CategoryName</small>
                <a asp-action="Details" asp-route-id="@tile.Id" class="my-title">@tile.Name</a>
                <div class="my-price">
                    @if (tile.Price is decimal price)
                    {
                        @price.ToString("#,0.## €")
                        <small>· @tile.PriceCategoryName</small>
                    }
                    else
                    {
                        @tile.PriceCategoryName
                    }
                </div>
                <small class="text-muted">erstellt am @tile.CreatedAt.ToString("dd.MM.yyyy")</small>
            </div>

            <div class="my-valid">
                <small class="text-muted d-block">Gültig bis</small>
                @if (tile.IsPermanent)
                {
                    <strong>unbegrenzt</strong>
                }
                else
                {
                    <strong>@tile.ValidUntil!.Value.ToString("dd.MM.yyyy")</strong>
                    @if (tile.DaysLeft < 0)
                    {
                        <small class="d-block text-danger">abgelaufen</small>
                    }
                    else
                    {
                        <small class="d-block @(tile.DaysLeft <= 7 ? "text-warning-emphasis" : "text-muted")">
                            noch @tile.DaysLeft @(tile.DaysLeft == 1 ? "Tag" : "Tage")
                        </small>
                    }
                }
            </div>

            <div class="my-actions">
                @if (isExpired)
                {
                    <span class="status-select status-sel-4">Abgelaufen</span>
                }
                else
                {
                    <form asp-action="SetStatus" asp-route-id="@tile.Id" method="post">
                        <select name="statusId" class="form-select form-select-sm status-select status-sel-@tile.StatusId"
                                onchange="this.form.submit()">
                            <option value="1" selected="@(tile.StatusId == 1)">Aktiv</option>
                            <option value="2" selected="@(tile.StatusId == 2)">Reserviert</option>
                            <option value="3" selected="@(tile.StatusId == 3)">
                                @(tile.ListingTypeId == 2 ? "Gefunden" : "Verkauft")
                            </option>
                        </select>
                    </form>
                }

                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@tile.Id" class="btn btn-sm btn-outline-primary flex-grow-1">
                        <i class="bi bi-pencil"></i> Bearbeiten
                    </a>
                    <form asp-action="Delete" asp-route-id="@tile.Id" method="post"
                          onsubmit="return confirm('Inserat wirklich löschen?')">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Löschen">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>

                @if (showExtend)
                {
                    <form asp-action="Extend" asp-route-id="@tile.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-success w-100">
                            Um 6 Monate verlängern
                        </button>
                    </form>
                }
            </div>
        </div>
    }

    <p id="noResults" class="text-muted text-center py-5 d-none">Keine Inserate in diesem Status.</p>
</div>

@section Scripts {
    <script src="~/js/views/my.js" asp-append-version="true"></script>
}