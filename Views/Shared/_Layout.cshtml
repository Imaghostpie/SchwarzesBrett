<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SchwarzesBrett</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SchwarzesBrett.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
</head>
<body style="background-color:#f5f7fb;">
    <header>
        <div class="d-flex justify-content-between border-bottom px-5 mb-5 py-2" 
            style="background-color: white">
            <div>
                @* <img asp-append-version="true" src="~/Images/Logo.jpg" style="max-height:125px;" /> *@
            </div>
            <div class="d-flex align-items-center gap-2">
                <a class="btn btn-secondary px-3 py-2" asp-controller="Home" asp-action="My">
                    <div class="d-flex gap-2">
                        <i class="bi bi-collection"></i>
                        <span>Meine Inserate</span>
                    </div>
                </a>
                <a class="btn btn-primary px-3 py-2" asp-controller="Home" asp-action="Create">
                    <div class="d-flex gap-1">
                        <i class="bi bi-plus"></i>
                        <span>Neues Inserat</span>
                    </div>
                </a>
            </div>
        </div>
    </header>
    <div class="container" style="background: #f5f7fb">
        <main role="main" class="pb-3">
           
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SchwarzesBrett - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
